{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "API local de evaluación de candidatos (ExpressoTS)",
  "main": "dist/src/main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/src/db/migrations && cp src/db/migrations/*.sql dist/src/db/migrations/",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix"
  },
  "dependencies": {
    "@expressots/adapter-express": "4.1.1",
    "@expressots/core": "4.1.1",
    "@expressots/shared": "4.1.1",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.4.7",
    "express": "5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "25.0.3",
    "eslint": "9.39.2",
    "prettier": "3.7.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0",
    "vitest": "^3.2.4"
  }
}
