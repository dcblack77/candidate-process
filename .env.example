# Copia este archivo a `.env` en la raíz del repo y ajusta si hace falta.
# Invariante (BLUEPRINT §10): la API solo escucha en localhost.
# Si API_HOST no es 127.0.0.1/localhost, la app lo fuerza a 127.0.0.1.

API_HOST=127.0.0.1
API_PORT=3010

# Ruta de la base de datos SQLite (relativa a la raíz del repo)
DB_PATH=./data/local.db

# Modelo local Gemma servido por llama.cpp (API OpenAI-compatible)
LLM_BASE_URL=http://localhost:8080
LLM_MODEL=gemma-4-E2B-it-qat-UD-Q4_K_XL
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=3
LLM_CONTEXT_TOKENS=22016

# Carpeta de prompts versionados (relativa a la raíz del repo)
PROMPTS_DIR=./prompts
