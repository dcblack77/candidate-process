# Copia este archivo a `.env` en la raíz del repo y ajusta si hace falta.
# Invariante (BLUEPRINT §10): la API solo escucha en localhost.
# Si API_HOST no es 127.0.0.1/localhost, la app lo fuerza a 127.0.0.1.

API_HOST=127.0.0.1
API_PORT=3010

# Host de la UI (Vite). Por defecto 0.0.0.0: accesible desde la LAN en
# http://<ip-de-esta-máquina>:5173 (la API sigue solo en localhost; el
# proxy de Vite reenvía /api internamente). OJO: no hay autenticación —
# cualquiera con acceso al puerto puede usar la app. Para volver al modo
# solo-local: WEB_HOST=127.0.0.1
# WEB_HOST=0.0.0.0

# La UI sirve HTTPS con un certificado propio que se genera solo en `certs/`.
# Hace falta para grabar la entrevista (§24) desde otro equipo: el navegador
# solo da acceso al micrófono en HTTPS o en localhost. La primera vez cada
# navegador avisa de que no conoce el certificado; se acepta la excepción y
# ya está. NO añade autenticación: la protección sigue siendo la red.
# Para servir en HTTP sin cifrar: WEB_HTTPS=false
# WEB_HTTPS=true

# Ruta de la base de datos SQLite (relativa a la raíz del repo)
DB_PATH=./data/local.db

# Modelo local Gemma servido por llama.cpp (API OpenAI-compatible)
LLM_BASE_URL=http://localhost:8080
LLM_MODEL=gemma-4-E2B-it-qat-UD-Q4_K_XL
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=3
LLM_CONTEXT_TOKENS=22016

# Carpeta de prompts versionados (relativa a la raíz del repo)
PROMPTS_DIR=./prompts

# Grabaciones de entrevista (§24, decisión del 2026-08-10): audio y
# transcripción de cada análisis. Se conservan para poder REANALIZAR sin
# repetir la entrevista cuando el trabajo se cae a medias.
#
# OJO: es el dato más sensible del sistema —la voz y las palabras literales de
# una persona real— y NO está cifrado en reposo. Está en su propia variable
# justamente para poder apuntarlo a un volumen cifrado sin mover la base de
# datos. Se borra desde la pantalla del candidato o al purgar el proceso; no
# hay caducidad automática.
RECORDINGS_DIR=./data/interviews

# Transcripción local (§24): faster-whisper-server del stack de /opt/ai-server
# (contenedor `voice-stt`, perfil `voice`). NO cuelga del router de :8080, que
# no enruta audio. Levantarlo: docker compose --profile voice up -d
STT_BASE_URL=http://127.0.0.1:8084
STT_MODEL=Systran/faster-whisper-base
STT_LANGUAGE=es
# 10 min: una pista de 50 minutos tarda ~4,5 min en CPU.
STT_TIMEOUT_MS=600000
